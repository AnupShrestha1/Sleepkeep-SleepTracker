    <!-- Guidance screen -->
    <string name="guidance_title">Sleep guidance</string>
    <string name="guidance_duration_title">Sleep duration</string>
    <string name="duration_met">Your average sleep over the last 7 days was %1$s, based on %2$d nights. That meets the general guideline of at least 7 hours for adults.</string>
    <string name="duration_not_met">Your average sleep over the last 7 days was %1$s, based on %2$d nights. That\'s below the general guideline of at least 7 hours for adults. %3$d of %2$d nights reached 7 hours.</string>
