    <string name="permission_notifications_off">Notifications: off. Monitoring still works, but its notification is hidden.</string>
    <string name="open_app_settings">Open app settings</string>
    <string name="battery_title">If monitoring stops during the night</string>
    <string name="battery_text">Some phones close apps overnight to save battery. If a night shows gaps saying the app was stopped, open the app\'s settings, go to Battery, and choose Unrestricted (or No restrictions). Keeping the phone charging overnight also helps.</string>
    <string name="delete_all_title">Delete all data</string>
