    <string name="guidance_schedule_title">Sleep schedule</string>
    <string name="schedule_text">You usually went to bed around %1$s. On average your bedtime was %2$s away from that. You usually woke around %3$s, varying by about %4$s.</string>
    <plurals name="minutes_count">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <string name="schedule_cdc">The CDC recommends going to bed and getting up at the same time every day. It doesn\'t give a number for how close is close enough, so this app describes your schedule rather than grading it.</string>
    <string name="guidance_about_title">About these figures</string>
    <string name="guidance_recommendation">The CDC recommends 7 or more hours of sleep for adults aged 18–60, 7–9 hours for ages 61–64, and 7–8 hours for 65 and over. The NHLBI recommends 7–9 hours for adults. This app checks against at least 7 hours, which all of these share.</string>
    <string name="guidance_disclaimer">These are general guidelines for adults, not a medical assessment. Sleep needs vary. This app doesn\'t measure sleep stages or detect sleep disorders. If you\'re concerned about your sleep, talk to a doctor. Recommended amounts are higher for people under 18.</string>
    <string name="guidance_source">%1$s: %2$s (page dated %3$s)</string>
    <string name="guidance_checked">Checked on %1$s. Links open in your browser; the guidance itself is stored in the app.</string>

    <!-- Settings & privacy -->
    <string name="settings_title">Settings</string>
    <string name="privacy_title">Your data stays on this phone</string>
    <string name="privacy_on_device">Sessions, check-in answers and sound events are stored only on this phone. There\'s no account.</string>
    <string name="privacy_no_internet">The app has no internet access. Source links open in your browser.</string>
    <string name="privacy_no_backup">Nothing is copied to cloud backup or to a new phone.</string>
    <string name="privacy_no_audio">No audio is ever saved. Sound monitoring keeps only when a loud sound happened, how long it lasted and roughly how loud it was.</string>
    <string name="privacy_no_tracking">No ads and no analytics.</string>
    <string name="permissions_title">Permissions</string>
    <string name="permission_mic_on">Microphone: allowed</string>
    <string name="permission_mic_off">Microphone: not allowed. Sound monitoring can\'t run.</string>
